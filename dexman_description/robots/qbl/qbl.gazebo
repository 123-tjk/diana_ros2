  <xacro:macro name="qbl_hand" params=" description:=qbl xyz:='0 0 0' rpy:='0 0 0'">

    <!--self collision  on-->

    <!--static on-->
    <xacro:property name="staticValue" value="false" />
    <!--Gravity off-->
    <xacro:property name="turnGravityOffValue" value="true" />
    
        <!-- Base link -->
    <gazebo reference="base_link_qbl">

        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->
    </gazebo>

    <!-- Thumb links -->
    <gazebo reference="left_Link1">

        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->

    </gazebo>
    <gazebo reference="left_Link2">

        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->

    </gazebo>
