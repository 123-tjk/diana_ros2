        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->

    </gazebo>

    <!-- Index left_Links -->
    <gazebo reference="left_Link5">

        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->

    </gazebo>
