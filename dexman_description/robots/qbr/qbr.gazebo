  <xacro:macro name="qbr_hand" params=" description:=qbr xyz:='0 0 0' rpy:='0 0 0'">

    <!--self collision  on-->

    <!--static on-->
    <xacro:property name="staticValue" value="false" />
    <!--Gravity off-->
    <xacro:property name="turnGravityOffValue" value="true" />
    
        <!-- Base link -->
    <gazebo reference="base_link_qbr">
        
        <static>${staticValue}</static>
        <turnGravityOff>${turnGravityOffValue}</turnGravityOff>
        <!-- <mu1>0.8</mu1>
        <mu2>0.8</mu2>  -->
    </gazebo>

    <!-- Thumb links -->
    <gazebo reference="link1">
        
