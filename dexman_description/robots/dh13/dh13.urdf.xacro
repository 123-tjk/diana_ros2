<?xml version="1.0" ?>
<xacro:root xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- DexH13. Joint numbers are 1-based so they match dexh13_hand joint states.
         Revolute effort and velocity are placeholders, not motor datasheet values. -->
    <xacro:macro name="dh13" params="side">
        <xacro:unless value="${side == 'left' or side == 'right'}">
            <xacro:property name="dh13_side_error" value="${dh13_side_must_be_left_or_right}" lazy_eval="false"/>
        </xacro:unless>
        <xacro:if value="${side == 'left'}">
        <joint name="left_palm_joint" type="fixed">
            <origin xyz="0.0375809952053067 -0.000196587122913705 0.024999983948119" rpy="-0.0365929260169142 0 -9.57069262251852E-05"/>
            <parent link="left_flange_link"/>
            <child link="left_palm_link"/>
            <axis xyz="0 0 0"/>
        </joint>
        <link name="left_palm_link">
            <inertial>
                <origin xyz="0.06196 -0.00065288 -0.0092301" rpy="0 0 0"/>
                <mass value="0.11485"/>
                <inertia ixx="0.00011573" ixy="-3.2138E-06" ixz="4.4062E-06" iyy="0.00014474" iyz="1.2505E-06" izz="0.00023363"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://dexman_description/meshes/dh13/left/left_palm_link.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://dexman_description/meshes/dh13/left/left_palm_link.STL"/>
                </geometry>
            </collision>
        </link>
        <link name="left_index_link1">
            <inertial>
                <origin xyz="0.0003082 8.3996E-10 8.9625E-07" rpy="0 0 0"/>
                <mass value="0.00017708"/>
                <inertia ixx="3.4764E-09" ixy="-1.0733E-16" ixz="-4.6319E-13" iyy="6.7235E-10" iyz="4.7794E-17" izz="3.8971E-09"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
